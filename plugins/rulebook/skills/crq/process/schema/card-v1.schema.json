{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rulebook:crq:card:1",
  "title": "Role card frontmatter, version 1",
  "description": "The frontmatter of each file in process/roles/. A list field is written as [a, b].",
  "type": "object",
  "required": ["role", "steps", "input", "must_not_see", "hand_off", "tools", "enforced_guardrails", "rules"],
  "additionalProperties": false,
  "properties": {
    "role": {
      "enum": ["coordinator", "design-reviewer", "test-first", "implementer", "cleanup", "finder", "verify-pass",
               "retro", "onboarder", "breaker"]
    },
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "input": {"type": "string", "minLength": 1},
    "must_not_see": {"type": "string", "minLength": 1},
    "hand_off": {"type": "string", "minLength": 1},
    "tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "enforced_guardrails": {
      "anyOf": [
        {
          "type": "array",
          "items": {"enum": ["read-only", "no-push", "no-web", "no-credentials", "judge-files-locked"]}
        },
        {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "Prose instead of IDs. Accepted in version 1 only, until every card lists IDs."
        }
      ]
    },
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z]+[0-9]+[a-z]?$"}}
  }
}
