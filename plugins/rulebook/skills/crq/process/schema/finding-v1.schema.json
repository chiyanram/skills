{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rulebook:crq:finding:1",
  "title": "Finding, version 1",
  "description": "One entry of the JSON a finder run returns.",
  "type": "object",
  "required": ["id", "lens", "axis", "kind", "file", "line", "rule", "category", "severity", "grade", "evidence",
               "finding", "fix"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "lens": {"type": "string", "minLength": 1},
    "axis": {"enum": ["standards", "spec"]},
    "kind": {"enum": ["rule", "logic"]},
    "file": {"type": "string", "minLength": 1},
    "line": {"type": ["integer", "string"]},
    "rule": {"type": ["string", "null"]},
    "category": {"type": "string"},
    "severity": {"type": "string", "minLength": 1},
    "grade": {"enum": ["cited", "walked", "ran"]},
    "evidence": {"type": "string", "minLength": 1},
    "finding": {"type": "string", "minLength": 1},
    "fix": {"type": "string"}
  }
}
